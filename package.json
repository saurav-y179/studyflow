{
  "name": "studyflow",
  "private": true,
  "version": "0.1.0",
  "description": "A student productivity tracker for daily planning, streaks, and study momentum.",
  "type": "module",
  "scripts": {
    "dev": "node dev.js",
    "dev:vite": "vite",
    "dev:server": "node server.js",
